# Copy to .env and adjust. Never commit the real file.

# --- PostgreSQL ---
POSTGRES_DB=gamelog
POSTGRES_USER=gamelog
POSTGRES_PASSWORD=change-me-local-only

# --- Object storage (MinIO in development) ---
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=gamelog-local
S3_SECRET_KEY=change-me-local-only-minio
S3_BUCKET=gamelog

# --- API ---
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5080
ALLOWED_ORIGINS=http://localhost:3000
# Loads the built-in starter catalog into an empty database (works without IGDB keys).
SEED_CATALOG=true
# Optional first administrator, created at start-up when no admin exists (needed for IGDB import).
SEED_ADMIN_USERNAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Swagger UI is always on in Development; set true to enable it elsewhere.
SWAGGER_ENABLED=false

# --- IGDB (Twitch developer console: https://dev.twitch.tv/console) ---
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- Web ---
WEB_PORT=3000
# Used by `npm run dev` outside Docker (compose wires the container value itself).
API_INTERNAL_URL=http://localhost:5080
