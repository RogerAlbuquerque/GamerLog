# Copy to .env and adjust. Never commit the real file.

# --- PostgreSQL ---
POSTGRES_DB=gamelog
POSTGRES_USER=gamelog
POSTGRES_PASSWORD=change-me-local-only

# --- Object storage (MinIO in development) ---
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=gamelog-local
S3_SECRET_KEY=change-me-local-only-minio
S3_BUCKET=gamelog

# --- API ---
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5080
ALLOWED_ORIGINS=http://localhost:3000
# Optional: if set, three demo users (demo_ana, demo_bruno, demo_carla) are seeded with this password.
SEED_DEMO_PASSWORD=
# Optional: promotes this existing username to Admin on startup (needed for IGDB import).
BOOTSTRAP_ADMIN_USERNAME=

# --- IGDB (Twitch developer console: https://dev.twitch.tv/console) ---
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- Web ---
WEB_PORT=3000
API_INTERNAL_URL=http://api:8080
