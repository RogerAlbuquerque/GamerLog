  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GameLog.Api\GameLog.Api.csproj" />
  </ItemGroup>

</Project>
